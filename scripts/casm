#!/usr/bin/env bash

readonly BUILD_DIR="${BUILD_DIR:-build}"
readonly COMPILER="${COMPILER:-nasm}"
readonly CC="${CC:-gcc}"

DISABLE_COLORS=false
OUTPUT="a.out"
ENTRYPOINT=
BUILD=false
CLEAR=false
RUN=false

declare -a ARGS=()
declare -a FILES=()
declare -a OBJS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  -o | --output)
    shift
    OUTPUT="$1"
    shift
    ;;
  -nc | --no-color)
    DISABLE_COLORS=true
    shift
    ;;
  entry)
    shift
    ENTRYPOINT="$1"
    shift
    ;;
  build)
    BUILD=true
    shift
    ;;
  clear)
    CLEAR=true
    shift
    ;;
  run)
    RUN=true
    shift
    ;;
  --)
    shift
    FILES+=("$@")
    break
    ;;
  *)
    ARGS+=("$1")
    shift
    ;;
  esac
done

_change_color_state() {
  if [ "$DISABLE_COLORS" = true ]; then
    C_DIM=""
    C_INFO=""
    C_ERROR=""
    C_CYAN=""
    C_PATH=""
    C_RESET=""
    return
  fi

  C_DIM=$'\x1b[0;90m'
  C_INFO=$'\x1b[0;1;92m'
  C_ERROR=$'\x1b[0;1;91m'
  C_CYAN=$'\x1b[0;1;96m'
  C_PATH=$'\x1b[0;1;3;94m'
  C_RESET=$'\x1b[0m'
}

[ -n "${NO_COLOR:-}" ] && DISABLE_COLORS=true
_change_color_state

_error() {
  echo -e "${C_DIM}:: ${C_ERROR}ERROR${C_DIM} - $1${C_RESET}" >&2
}

_info() {
  echo "${C_DIM}:: $1${C_RESET}"
}

if ! command -v "$COMPILER" >/dev/null; then
  _error "Cannot find ${C_PATH}$COMPILER"
  exit 1
fi

if ! command -v "$CC" >/dev/null; then
  _error "Cannot find ${C_PATH}$CC"
  exit 1
fi

[ "$BUILD" == true ] && {
  [ ! -d "$BUILD_DIR/o" ] && mkdir -p "$BUILD_DIR/o"

  for file in "${FILES[@]}"; do
    obj_file="$BUILD_DIR/o/${file%.*}.o"
    _info "Building ${C_CYAN}$obj_file${C_DIM}..."

    "$COMPILER" "${ARGS[@]}" "$file" -o "$obj_file"

    OBJS+=("$obj_file")
  done

  _info "Linking object files."
  "$CC" "${OBJS[@]}" $ENTRYPOINT -o "$BUILD_DIR/$OUTPUT"
  _info "${C_INFO}Build complete!"
}

[ "$RUN" == true ] && {
  _info "Running ${C_CYAN}$BUILD_DIR/$OUTPUT${C_DIM}..."
  [ ! -f "$BUILD_DIR/$OUTPUT" ] && {
    _error "Binary ${C_PATH}$BUILD_DIR/$OUTPUT${C_DIM} not found!"
    exit 1
  }
  echo

  "./$BUILD_DIR/$OUTPUT"
  STATUS=$?

  [ "$CLEAR" == true ] && rm -r "$BUILD_DIR"

  exit $STATUS
}

[ "$CLEAR" == true ] && [ -d "$BUILD_DIR" ] && rm -r "$BUILD_DIR"
