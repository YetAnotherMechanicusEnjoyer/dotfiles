#!/usr/bin/env bash
#    ____         __       ____               __     __
#   /  _/__  ___ / /____ _/ / / __ _____  ___/ /__ _/ /____ ___
#  _/ // _ \(_-</ __/ _ `/ / / / // / _ \/ _  / _ `/ __/ -_|_-<
# /___/_//_/___/\__/\_,_/_/_/  \_,_/ .__/\_,_/\_,_/\__/\__/___/
#                                 /_/
#
# I (YetAnotherMechanicusEnjoyer) took this script from Stephan Rabbe's ML4W

# Check if command exists
_checkCommandExists() {
  cmd="$1"
  if ! command -v "$cmd" >/dev/null; then
    return 1
  fi
  return 0
}

# ------------------------------------------------------
# Confirm Start
# ------------------------------------------------------

sleep 1
clear
if _checkCommandExists "figlet"; then
  figlet -f smslant "Updates"
else
  echo "Updates"
fi

echo
if gum confirm "Do you want to start the update now?"; then
  echo
  echo ":: Update started..."
elif [ $? -eq 130 ]; then
  exit 130
else
  echo
  echo ":: Update canceled."
  exit
fi

# -----------------------------------------------------
# Install update
# -----------------------------------------------------

if _checkCommandExists "pacman"; then
  if _checkCommandExists "yay"; then
    yay
  elif _checkCommandExists "paru"; then
    paru -Syu --noconfirm
  else
    pacman -Syu --noconfirm
  fi
else
  echo ":: ERROR - Script is made for Arch Linux only"
  echo "Press [ENTER] to close."
  read
  exit 1
fi
echo

# Flatpak
if _checkCommandExists "flatpak"; then
  echo ":: Searching for Flatpak updates..."
  flatpak update
  echo
fi

# Rustup
if _checkCommandExists "rustup"; then
  echo ":: Updating rustup"
  rustup update
  echo
fi

# Zinit
if _checkCommandExists "zsh"; then
  SKIP_EXEC_ZSH=1 zsh -i -c '
    if type zinit >/dev/null 2>&1; then
      echo ":: Updating zinit"
      zinit self-update
      zinit update
      echo
    fi
  '
fi

# Reload Waybar
pkill -RTMIN+1 waybar

# Finishing
echo ":: Update complete! Press [ENTER] to close."
read
