#!/usr/bin/env bash
#    ____         __       ____               __     __
#   /  _/__  ___ / /____ _/ / / __ _____  ___/ /__ _/ /____ ___
#  _/ // _ \(_-</ __/ _ `/ / / / // / _ \/ _  / _ `/ __/ -_|_-<
# /___/_//_/___/\__/\_,_/_/_/  \_,_/ .__/\_,_/\_,_/\__/\__/___/
#                                 /_/
#
# I (YetAnotherMechanicusEnjoyer) took this script from Stephan Rabbe's ML4W

# Check if command exists
_checkCommandExists() {
  cmd="$1"
  if ! command -v "$cmd" >/dev/null; then
    return 1
  fi
  return 0
}

# ------------------------------------------------------
# Confirm Start
# ------------------------------------------------------

sleep 1
clear
printf "\e[1;90m"
if _checkCommandExists "figlet"; then
  figlet -f smslant "Updates"
else
  echo "Updates"
fi
printf "\e[0m"

echo
if gum confirm "Do you want to start the update now?"; then
  echo
  echo -e "\e[1;90m:: Update started...\e[0m"
elif [ $? -eq 130 ]; then
  exit 130
else
  echo
  echo -e "\e[1;90m:: Update canceled.\e[0m"
  exit
fi

# -----------------------------------------------------
# Install update
# -----------------------------------------------------

if _checkCommandExists "pacman"; then
  if _checkCommandExists "yay"; then
    yay
  elif _checkCommandExists "paru"; then
    paru -Syu --noconfirm
  else
    pacman -Syu --noconfirm
  fi
else
  echo -e "\e[1;90m:: \e[1;3;91mERROR\e[1;90m - Script is made for Arch Linux only\e[0m"
  echo -e "\e[1;90m:: Press \e[1;94m[ENTER]\e[1;90m to close.\e[0m"
  read
  exit 1
fi
echo

# Flatpak
if _checkCommandExists "flatpak"; then
  echo -e "\e[1;90m:: Searching for Flatpak updates..."
  flatpak update
  echo
fi

# Rustup
if _checkCommandExists "rustup"; then
  echo -e "\e[1;90m:: Updating \e[1;3;94mrustup\e[0m"
  rustup update
  echo
fi

# Zinit
if _checkCommandExists "zsh"; then
  SKIP_EXEC_ZSH=1 zsh -i -c '
    if type zinit >/dev/null 2>&1; then
      echo -e "\e[1;90m:: Updating \e[1;3;94mzinit\e[0m"
      zinit self-update
      zinit update
      echo
    fi
  '
fi

# Reload Waybar
pkill -RTMIN+1 waybar

# Finishing
echo -e "\e[1;90m:: Update complete! Press \e[1;94m[ENTER]\e[1;90m to close.\e[0m"
read
