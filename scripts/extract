#!/usr/bin/env bash

DISABLE_COLORS=false

_change_color_state() {
  if [ "$DISABLE_COLORS" = true ]; then
    C_DIM=""
    C_INFO=""
    C_WARN=""
    C_ERROR=""
    C_PATH=""
    C_RESET=""
  else
    C_DIM="\e[0;90m"
    C_INFO="\e[0;1;92m"
    C_WARN="\e[0;1;93m"
    C_ERROR="\e[0;1;91m"
    C_PATH="\e[0;1;3;94m"
    C_RESET="\e[0m"
  fi
}

if [ -n "$NO_COLOR" ]; then
  DISABLE_COLORS=true
fi

_change_color_state

_info() {
  echo -e "${C_DIM}:: ${C_INFO}INFO${C_RESET}${C_DIM} - $1${C_RESET}"
}

_warn() {
  echo -e "${C_DIM}:: ${C_WARN}WARN${C_RESET}${C_DIM} - $1${C_RESET}"
}

_error() {
  echo -e "${C_DIM}:: ${C_ERROR}ERROR${C_RESET}${C_DIM} - $1${C_RESET}"
}

_help() {
  if [ "$DISABLE_COLORS" = true ]; then
    echo -e ":: Usage:"
    echo -e "   extract [OPTIONS] [ARCHIVE_PATH] [EXTRACT_PATH]"
    echo ""
    echo -e ":: Options:"
    echo -e "   -j, --jobs <n>               Set maximum parallel extraction jobs (default: 5)"
    echo -e "   -o, --overwrite, --force     Overwrite existing files on conflict (default)"
    echo -e "   -s, --skip, --keep           Skip existing files on conflict"
    echo -e "   -h, --help                   Display this help message and exit"
    echo -e "   -nc, --no-color              Disable ANSI colors"
    echo ""
    echo -e ":: Arguments:"
    echo -e "   ARCHIVE_PATH Directory containing archives to extract (default: current directory)"
    echo -e "   EXTRACT_PATH Destination directory for extracted files (default: current directory)"
  else
    echo -e "\e[0;90m:: \e[1;94mUsage\e[0;90m:\e[0m"
    echo -e "   \e[0;1;92mextract\e[0m [OPTIONS] [ARCHIVE_PATH] [EXTRACT_PATH]\e[0m"
    echo ""
    echo -e "\e[0;90m:: \e[1;94mOptions\e[0;90m:\e[0m"
    echo -e "   \e[0;1m-j, --jobs <n>\e[0m           \tSet maximum parallel extraction jobs \e[0;90m(default: 5)\e[0m"
    echo -e "   \e[0;1m-o, --overwrite, --force\e[0m \tOverwrite existing files on conflict \e[0;90m(default)\e[0m"
    echo -e "   \e[0;1m-s, --skip, --keep\e[0m       \tSkip existing files on conflict\e[0m"
    echo -e "   \e[0;1m-h, --help\e[0m               \tDisplay this help message and exit\e[0m"
    echo -e "   \e[0;1m-nc, --no-color\e[0m          \tDisable ANSI colors\e[0m"
    echo ""
    echo -e "\e[0;90m:: \e[0;1;94mArguments\e[0;90m:\e[0m"
    echo -e "   \e[0;1mARCHIVE_PATH\e[0m \tDirectory containing archives to extract \e[0;90m(default: current directory)\e[0m"
    echo -e "   \e[0;1mEXTRACT_PATH\e[0m \tDestination directory for extracted files \e[0;90m(default: current directory)\e[0m"
  fi
}

_fallback() {
  local cmd="$1"
  local file="$2"
  local target_path="$3"

  _warn "${C_PATH}$cmd${C_DIM} not found, fallback on ${C_PATH}7z${C_DIM}..."
  if [ "$cmd" = "tar" ]; then
    7z x -so "$file" 2>/dev/null | 7z x -si -ttar -o"$target_path" "$SEVENZ_FLAG" >/dev/null 2>&1
  else
    7z x "$file" -o"$target_path" "$SEVENZ_FLAG" >/dev/null 2>&1
  fi
}

_extract() {
  local file="$1"
  local extract_base="$2"
  local filename
  filename=$(basename "$file")

  local target_name="${filename%.*}"
  local target_path="$extract_base/$target_name"

  case "$filename" in
  *.tar.bz2 | *.tbz2 | *.tar.gz | *.tgz | *.tar.xz | *.txz | *.tar | *.zip | *.rar | *.gz | *.7z)
    _info "Extracting ${C_PATH}$filename${C_DIM}..."
    ;;
  *)
    _warn "Cannot extract ${C_PATH}$filename"
    return
    ;;
  esac

  case "$filename" in
  *.tar.bz2 | *.tbz2)
    if command -v tar >/dev/null 2>&1; then
      mkdir -p "$target_path" && tar xjf "$file" $TAR_FLAG -C "$target_path" >/dev/null 2>&1
    else
      _fallback "tar" "$file" "$target_path"
    fi
    ;;

  *.tar.gz | *.tgz)
    if command -v tar >/dev/null 2>&1; then
      mkdir -p "$target_path" && tar xzf "$file" $TAR_FLAG -C "$target_path" >/dev/null 2>&1
    else
      _fallback "tar" "$file" "$target_path"
    fi
    ;;

  *.tar.xz | *.txz)
    if command -v tar >/dev/null 2>&1; then
      mkdir -p "$target_path" && tar xJf "$file" $TAR_FLAG -C "$target_path" >/dev/null 2>&1
    else
      _fallback "tar" "$file" "$target_path"
    fi
    ;;

  *.tar)
    if command -v tar >/dev/null 2>&1; then
      mkdir -p "$target_path" && tar xf "$file" $TAR_FLAG -C "$target_path" >/dev/null 2>&1
    else
      _fallback "tar" "$file" "$target_path"
    fi
    ;;

  *.zip)
    if command -v unzip >/dev/null 2>&1; then
      unzip -q $UNZIP_FLAG "$file" -d "$target_path" >/dev/null 2>&1
    else
      _fallback "unzip" "$file" "$target_path"
    fi
    ;;

  *.rar)
    if command -v unrar >/dev/null 2>&1; then
      mkdir -p "$target_path" && unrar x $UNRAR_FLAG "$file" "$target_path/" >/dev/null 2>&1
    else
      _fallback "unrar" "$file" "$target_path"
    fi
    ;;

  *.gz)
    if command -v gunzip >/dev/null 2>&1; then
      gunzip -k $GZIP_FLAG "$file" 2>/dev/null && mv -f "${file%.*}" "$EXTRACT_PATH/" 2>/dev/null
    else
      _fallback "gunzip" "$file" "$target_path"
    fi
    ;;

  *.7z)
    7z x "$file" -o"$target_path" "$SEVENZ_FLAG" >/dev/null 2>&1
    ;;

  *)
    _warn "Cannot extract ${C_PATH}$filename"
    ;;
  esac
}

_extract_dir() {
  local dir="$1"
  local path="$2"
  local max_jobs="$3"

  for file in "$dir"/*; do
    [ -f "$file" ] || continue

    _extract "$file" "$path" &

    [[ $(jobs -r -p | wc -l) -ge $max_jobs ]] && wait -n 2>/dev/null
  done

  wait
}

MAX_JOBS=5
OVERWRITE_MODE="overwrite"
POSITIONAL_ARGS=()
PRINT_HELP=false

while [[ $# -gt 0 ]]; do
  case $1 in
  -j | --jobs)
    if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
      MAX_JOBS="$2"
      shift 2
    else
      _error "Option \`${C_PATH}$1${C_RESET}\` requires a valid numeric value."
      exit 1
    fi
    ;;
  -o | --overwrite | --force)
    OVERWRITE_MODE="overwrite"
    shift
    ;;
  -s | --skip | --keep)
    OVERWRITE_MODE="skip"
    shift
    ;;
  -h | --help)
    PRINT_HELP=true
    shift
    ;;
  -nc | --no-color)
    DISABLE_COLORS=true
    _change_color_state
    shift
    ;;
  -*)
    _error "Unknown option ${C_PATH}$1${C_DIM}"
    echo -e "${C_DIM}:: Try ${C_PATH}-h${C_DIM} or ${C_PATH}--help${C_DIM} for more information.${C_RESET}"
    exit 1
    ;;
  *)
    POSITIONAL_ARGS+=("$1")
    shift
    ;;
  esac
done

[ "$PRINT_HELP" = true ] && _help && exit

set -- "${POSITIONAL_ARGS[@]}"

ARCHIVE_PATH="${1:-$PWD}"
EXTRACT_PATH="${2:-$PWD}"

if [ "$OVERWRITE_MODE" = "overwrite" ]; then
  TAR_FLAG="--overwrite"
  UNZIP_FLAG="-o"
  UNRAR_FLAG="-o+"
  SEVENZ_FLAG="-aoa"
  GZIP_FLAG="-f"
else
  TAR_FLAG="--skip-old-files"
  UNZIP_FLAG="-n"
  UNRAR_FLAG="-o-"
  SEVENZ_FLAG="-aos"
  GZIP_FLAG=""
fi

shopt -s nullglob

if [[ -d "$ARCHIVE_PATH" ]]; then
  mkdir -p "$EXTRACT_PATH"

  _extract_dir "$ARCHIVE_PATH" "$EXTRACT_PATH" "$MAX_JOBS"
elif [[ -f "$ARCHIVE_PATH" ]]; then
  mkdir -p "$EXTRACT_PATH"

  _extract "$ARCHIVE_PATH" "$EXTRACT_PATH"
else
  _error "${C_PATH}$ARCHIVE_PATH${C_DIM} doesn't exist" && exit 1
fi

shopt -u nullglob

[ "$DISABLE_COLORS" = true ] && echo ":: Extraction complete!" && exit
echo -e "\e[0;1;90m:: Extraction \e[0;1;3;92mcomplete\e[0;90m!\e[0m"
